# Required for private A2A endpoints
A2A_BEARER_TOKEN=replace-with-a-long-random-secret

# Required persistent store (Upstash Redis -> REST URL and REST token)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# OpenAI-compatible chat completions API
OPENAI_API_KEY=replace-with-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
